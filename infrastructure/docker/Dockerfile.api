# Production image for the FastAPI service AND the Celery worker.
#
# One image, two start commands. They share every dependency, so building twice
# would double build minutes and create a class of bug where the API and the worker
# run different code. The start command is what differentiates the services.
#
# Build from the REPO ROOT, not from this directory:
#   docker build -f infrastructure/docker/Dockerfile.api -t thedrop-api .

# ---------------------------------------------------------------- builder
FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Manifests first, so a source-only change does not invalidate the dependency layer.
# Every workspace member's pyproject.toml is needed for uv to resolve the workspace.
COPY pyproject.toml uv.lock ./
COPY packages/config/pyproject.toml packages/config/
COPY packages/database/pyproject.toml packages/database/
COPY services/api/pyproject.toml services/api/
COPY services/worker/pyproject.toml services/worker/

# --no-install-workspace resolves and installs third-party dependencies only. The
# workspace packages themselves are installed after the source is copied, so this
# heavy layer is cached across ordinary code changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace

COPY packages/ packages/
COPY services/ services/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---------------------------------------------------------------- runtime
FROM python:3.12-slim-bookworm AS runtime

# curl is used by the container healthcheck. Nothing else is added: every package
# in a production image is attack surface.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 thedrop

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production

WORKDIR /app

COPY --from=builder --chown=thedrop:thedrop /app/.venv /app/.venv
COPY --from=builder --chown=thedrop:thedrop /app/packages /app/packages
COPY --from=builder --chown=thedrop:thedrop /app/services /app/services
COPY --chown=thedrop:thedrop pyproject.toml ./

# Never run as root. A container escape starts from whatever the process owns.
USER thedrop

WORKDIR /app/services/api

EXPOSE 8000

# Railway injects $PORT and it is not always 8000. Binding 0.0.0.0 is required --
# the platform routes to the container from outside, unlike the VPS deployment
# where the service binds loopback behind nginx.
#
# --proxy-headers makes Uvicorn trust X-Forwarded-Proto from the platform's load
# balancer, so request.url.scheme is "https". Without it the API believes it is
# serving plain HTTP and `secure` cookies are never set.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-2} --proxy-headers --forwarded-allow-ips='*' --no-access-log"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/healthz" || exit 1
