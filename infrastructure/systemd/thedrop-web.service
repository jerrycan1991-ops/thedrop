[Unit]
Description=THE DROP web (Next.js)
Documentation=file:///opt/thedrop/docs/DEPLOYMENT.md
# The web tier talks to PostgreSQL and Redis directly, so it depends on the data
# services — not only on the API. Before the Node migration this unit needed nothing
# but thedrop-api.
#
# thedrop-api is still a dependency: /api/v1/worker/* and PUT /api/v1/admin/settings/{key}
# are proxied to it. It is `Wants`, not `Requires`, so the public site still comes up if
# FastAPI is down — only those proxied paths fail, which is the intended degradation.
After=network-online.target postgresql.service thedrop-redis.service thedrop-api.service
Wants=network-online.target thedrop-api.service
Requires=postgresql.service thedrop-redis.service

[Service]
Type=exec
User=thedrop
Group=thedrop
WorkingDirectory=/opt/thedrop/apps/web
EnvironmentFile=/etc/thedrop/thedrop.env

Environment=NODE_ENV=production
# Bound to loopback. The hosting panel's nginx proxies to it; port 3100 is never
# exposed publicly.
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100

ExecStart=/usr/bin/node /opt/thedrop/apps/web/.next/standalone/apps/web/server.js

Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/www/thedrop /opt/thedrop/apps/web/.next/cache

MemoryMax=800M
MemoryHigh=700M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=thedrop-web

[Install]
WantedBy=multi-user.target
