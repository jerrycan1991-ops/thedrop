[Unit]
Description=THE DROP API (FastAPI)
Documentation=file:///opt/thedrop/docs/DEPLOYMENT.md
# Postgres and Redis run natively under systemd, not in containers (ADR-0011).
# `postgresql.service` is Debian's umbrella unit; `thedrop-redis.service` is this
# project's own instance on 6380, distinct from the panel's Redis on 6379.
After=network-online.target postgresql.service thedrop-redis.service
Wants=network-online.target
Requires=postgresql.service thedrop-redis.service

[Service]
Type=exec
User=thedrop
Group=thedrop
WorkingDirectory=/opt/thedrop/services/api
EnvironmentFile=/etc/thedrop/thedrop.env

# Migrations run before the service accepts traffic. Idempotent, so a restart on an
# already-migrated database is a no-op.
ExecStartPre=/opt/thedrop/.venv/bin/alembic -c /opt/thedrop/packages/database/alembic.ini upgrade head
# --proxy-headers matches infrastructure/docker/Dockerfile.api. FastAPI only ever
# receives traffic from the Next.js rewrite on loopback, so the trusted-proxy list is
# 127.0.0.1 rather than the container image's '*'. Without this, X-Forwarded-For is
# ignored and every request appears to come from the proxy.
ExecStart=/opt/thedrop/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=5
# Give up and alert rather than restart-looping a genuinely broken deploy.
StartLimitBurst=5
StartLimitIntervalSec=120

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/www/thedrop /var/log/thedrop

# Bounded so the API cannot starve Postgres on an 8GB box.
MemoryMax=700M
MemoryHigh=600M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=thedrop-api

[Install]
WantedBy=multi-user.target
