# THE DROP — environment template
#
# Copy to .env for local development:   cp .env.example .env
# On the VPS this lives at /etc/thedrop/thedrop.env (mode 0640, root:thedrop)
#
# NEVER commit a filled-in copy. Every value below is a PLACEHOLDER.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ---------------------------------------------------------------------------
# PRODUCTION FILE FORMAT (/etc/thedrop/thedrop.env)
#
# The production file is read by TWO parsers with different rules:
#   * systemd `EnvironmentFile=` (thedrop-api / -worker / -web)
#   * `set -a; source ...` in infrastructure/scripts/deploy.sh
#
# So the production copy must be stricter than this development template:
#
#   1. QUOTE any value containing a space.
#      VERIFIED: bash sourcing an UNQUOTED value with a space does not abort — it
#      prints "Drop: command not found" and silently sets the variable to the first
#      word only. Always quote such values, as SITE_NAME does below.
#
#   2. NO INLINE COMMENTS. Put comments on their own line.
#      systemd's EnvironmentFile parser ignores lines starting with # or ;, but
#      trailing-comment handling is not something we have verified on the target
#      systemd version. A value of `3100    # bound to loopback` would be a very
#      confusing failure. INFERRED risk; the cost of avoiding it is zero.
#
# The inline comments below are safe here because this file is only ever read by
# python-dotenv (development), which strips them.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- core
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
SITE_URL=http://localhost:3100     # production: https://thedrop.channel
SITE_NAME="The Drop"

# BUILD-TIME variable. Next.js inlines every NEXT_PUBLIC_* value into the bundle when
# `next build` runs — setting it only at runtime has NO effect.
#
# It is the base for canonical URLs, the sitemap, robots.txt and OpenGraph tags. If it
# is missing during a production build, every canonical URL ships as
# http://localhost:3100, which for a site whose growth depends on Google News and
# Discover is a serious defect rather than a cosmetic one.
#
# deploy.sh sources this file before building and refuses to build a production
# release without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3100   # production: https://thedrop.channel

# ---------------------------------------------------------------- database
# Phase 1 requires Docker Desktop locally. Until then, DB-backed steps are blocked
# and DB-marked tests skip automatically.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=thedrop
POSTGRES_USER=thedrop
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql+psycopg://thedrop:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/thedrop

# ---------------------------------------------------------------- redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_LOCAL_ONLY
REDIS_URL=redis://:CHANGE_ME_LOCAL_ONLY@127.0.0.1:6379/0

# As of Phase 2 the Next.js server reads DATABASE_URL directly. Keep the pool small:
# Postgres runs with max_connections=60 shared between the API, the worker and the web
# tier, and every warm serverless instance holds its own pool.
DATABASE_POOL_MAX=5
CELERY_BROKER_URL=redis://:CHANGE_ME_LOCAL_ONLY@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_LOCAL_ONLY@127.0.0.1:6379/2

# ---------------------------------------------------------------- auth / sessions
SESSION_SECRET=CHANGE_ME_32_BYTES_MINIMUM
SESSION_COOKIE_NAME=thedrop_session
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_HOURS=2
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ---------------------------------------------------------------- internal service wiring
API_INTERNAL_URL=http://127.0.0.1:8000     # Next.js rewrites /api/* here. Never public.
WEB_PORT=3100                              # bound to 127.0.0.1 in production
API_PORT=8000

# ---------------------------------------------------------------- split-host deployment
# Leave ALL THREE empty for a single-origin deployment (one VPS). They are only
# needed when the browser loads pages from one origin and calls the API on another,
# e.g. Vercel (thedrop.channel) + Railway (api.thedrop.channel).
#
# CORS_ALLOWED_ORIGINS: comma-separated, explicit. A wildcard is REJECTED at startup --
# browsers refuse a wildcard origin on credentialed requests, and failing loudly here
# beats debugging "login does nothing" against a live site.
#   production: https://thedrop.channel,https://www.thedrop.channel
CORS_ALLOWED_ORIGINS=

# TRUSTED_HOSTS: comma-separated Host headers this API will answer to. Blocks
# Host-header poisoning and stops the API responding on the platform's default
# *.up.railway.app URL once a custom domain is attached.
#   production: api.thedrop.channel
TRUSTED_HOSTS=

# COOKIE_DOMAIN: scope for the admin session cookie. Set to the leading-dot parent
# domain so a cookie set by api.thedrop.channel is sent to thedrop.channel. Both share
# a registrable domain, so requests stay "same-site" and SameSite=Lax still applies --
# SameSite=None is NOT required and would weaken CSRF protection for no benefit.
#   production: .thedrop.channel
COOKIE_DOMAIN=

# Uvicorn worker processes. 2 fits a 512MB-1GB container. Raise only with memory.
WEB_CONCURRENCY=2

# ---------------------------------------------------------------- media storage
MEDIA_STORAGE_BACKEND=local                # local | s3
MEDIA_ROOT=./var/media                     # production: /var/www/thedrop/media
MEDIA_PUBLIC_PREFIX=/media
MEDIA_MAX_UPLOAD_MB=8                      # chunked above this; see DEPLOYMENT.md §7

# ---------------------------------------------------------------- AI (Phase 3+, desktop only)
# Not required for Phase 1. The VPS never loads a model.
ANTHROPIC_API_KEY=
AI_ENABLED=false
MODEL_TIER_CHEAP=claude-haiku-4-5-20251001
MODEL_TIER_STANDARD=claude-sonnet-5
MODEL_TIER_CRITICAL=claude-opus-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ---------------------------------------------------------------- desktop worker (Phase 2+)
WORKER_NODE_NAME=rtx4070s-desktop
WORKER_TOKEN=                              # issued by the API; never chosen by hand
WORKER_API_BASE=https://thedrop.channel/api/v1/worker
WORKER_POLL_TIMEOUT_SECONDS=25
WORKER_HEARTBEAT_SECONDS=30
WORKER_LEASE_SECONDS=900

# ---------------------------------------------------------------- news providers (Phase 2)
GNEWS_API_KEY=
NEWSAPI_KEY=

# ---------------------------------------------------------------- affiliate (Phase 5B)
AFFILIATE_ENABLED=false
AFFILIATE_PRICE_MAX_AGE_HOURS=24           # older prices are never rendered as current
AFFILIATE_LINK_CHECK_INTERVAL_HOURS=6
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
CJ_API_KEY=
SHAREASALE_API_TOKEN=
RAKUTEN_API_KEY=

# ---------------------------------------------------------------- monetization (Phase 5)
ADS_ENABLED=false
ADSENSE_PUBLISHER_ID=
NEWSLETTER_PROVIDER=local
NEWSLETTER_API_KEY=

# ---------------------------------------------------------------- editorial gates (configurable)
PUBLISHING_ENABLED=false                   # Phase 1 publishes nothing automatically
GATE_AUTO_PUBLISH_MIN=95
GATE_VERIFY_THEN_PUBLISH_MIN=85
GATE_SECOND_REVIEW_MIN=70
US_RELEVANCE_MIN=35
CLUSTER_JOIN_THRESHOLD=0.82
VIRAL_HALF_LIFE_HOURS=8
DAILY_ARTICLE_TARGET_MIN=20
DAILY_ARTICLE_TARGET_MAX=30

# ---------------------------------------------------------------- budgets (Phase 4+)
DAILY_AI_BUDGET_USD=0
MONTHLY_AI_BUDGET_USD=0
BUDGET_ACTION_ON_BREACH=halt               # warn | throttle | halt
